# Las variables VITE_ son públicas: nunca incluir secretos.

# Supabase: URL y clave publicable (no sustituye las políticas RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stellar: red Testnet de referencia y URL RPC.
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=

# Identificador del futuro contrato de registro.
VITE_STELLAR_REGISTRY_CONTRACT_ID=
